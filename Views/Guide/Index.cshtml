@{
    Layout = "~/Views/Shared/_GuideLayout.cshtml";
    ViewBag.Title = "دليل المستخدم";
}

@section Styles {
<link rel="stylesheet" href="~/css/guide-reader.css" asp-append-version="true" />
}

<div class="gr-root" id="grRoot">
    <div class="gr-zoom-overlay" id="grZoomOverlay" aria-hidden="true">
        <button type="button" class="gr-zoom-close" id="grZoomClose" aria-label="إغلاق"><i class="bi bi-x-lg"></i></button>
        <div class="gr-zoom-content" id="grZoomContent"></div>
    </div>

    <button type="button" class="gr-mobile-toggle d-lg-none" id="grMobileToggle" aria-label="فتح الفهرس">
        <i class="bi bi-list-ul"></i>
    </button>

    <aside class="gr-sidebar" id="grSidebar">
        <div class="gr-sidebar-head">
            <h2 class="gr-sidebar-title">دليل المستخدم</h2>
            <button type="button" class="gr-sidebar-close d-lg-none" id="grSidebarClose" aria-label="إغلاق"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="gr-search-wrap">
            <input type="search" id="grSearch" class="gr-search-input" placeholder="بحث سريع في العناوين..." autocomplete="off" />
        </div>
        <nav class="gr-tree" id="grTree" aria-label="فهرس الدليل">
            <div class="gr-tree-loading"><div class="spinner-border spinner-border-sm"></div> جاري التحميل...</div>
        </nav>
    </aside>

    <div class="gr-main">
        <div class="gr-progress-wrap">
            <div class="gr-progress-bar" id="grProgressBar" style="width:0%;"></div>
        </div>

        <div class="gr-reader" id="grReader">
            <div class="gr-empty" id="grEmpty">
                <i class="bi bi-journal-x"></i>
                <p>لا توجد صفحات في دليل المستخدم حالياً.</p>
                <span class="gr-empty-hint">يمكن للمسؤول إضافة المحتوى من الإعدادات العامة ← دليل المستخدم.</span>
            </div>

            <div class="gr-book d-none" id="grBook">
                <div class="gr-book-spread system-section active">
                    <article class="gr-page book-page page-right" id="grPageContent">
                        <div class="gr-content-body" id="grContentBody"></div>
                        <footer class="page-number-footer" id="grPageFootRight"></footer>
                    </article>
                    <article class="gr-page book-page page-left" id="grPageMedia">
                        <div class="gr-media-panel" id="grMediaPanel"></div>
                        <footer class="page-number-footer" id="grPageFootLeft"></footer>
                    </article>
                </div>
            </div>
        </div>

        <div class="gr-controls controls" id="grControls">
            <button type="button" class="gr-btn gr-btn-nav" id="grPrevBtn" disabled>السابق</button>
            <button type="button" class="gr-btn gr-btn-theme" id="grThemeBtn" title="تبديل الوضع المظلم">
                <i class="bi bi-moon-stars-fill" id="grThemeIcon"></i> تبديل الوضع المظلم
            </button>
            <button type="button" class="gr-btn gr-btn-nav" id="grNextBtn" disabled>التالي</button>
        </div>
    </div>
</div>

@section Scripts {
<script>window.GR_USER_ID = @(ViewBag.UserId ?? 0);</script>
<script src="~/js/guide-reader.js" asp-append-version="true"></script>
<script>grInit();</script>
}
