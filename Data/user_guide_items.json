    "Name": "\u0645\u0642\u062F\u0645\u0629",
    "Content": "\u003Ch2\u003E\u0645\u0642\u062F\u0645\u0629\u003C/h2\u003E\u003Cp\u003E\u0647\u0630\u0647 \u0627\u0644\u0648\u062B\u064A\u0642\u0629 \u0647\u064A \u0627\u0644\u062F\u0644\u064A\u0644 \u0627\u0644\u0623\u0633\u0627\u0633\u064A \u0644\u0645\u0633\u062A\u062E\u062F\u0645\u064A \u0646\u0638\u0627\u0645 \u0623\u062A\u0645\u062A\u0629 \u0627\u0644\u0646\u0645\u0627\u0630\u062C \u0648\u0625\u062F\u0627\u0631\u0629 \u0633\u064A\u0631 \u0627\u0644\u0639\u0645\u0644\u060C \u0648\u0642\u062F \u062A\u0645 \u0625\u0639\u062F\u0627\u062F \u0647\u0630\u0627 \u0627\u0644\u062F\u0644\u064A\u0644 \u0644\u0644\u0645\u0633\u0627\u0639\u062F\u0629 \u0641\u064A \u0627\u0644\u062A\u0639\u0631\u0641 \u0639\u0644\u0649 \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u062A\u0639\u0627\u0645\u0644 \u0645\u0639 \u0647\u0630\u0627 \u0627\u0644\u0646\u0638\u0627\u0645\u060C \u062D\u064A\u062B\u064F \u064A\u0639\u0631\u0636 \u0647\u0630\u0627 \u0627\u0644\u062F\u0644\u064A\u0644 \u0631\u062D\u0644\u0629 \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645 \u0641\u064A \u0643\u0644 \u0648\u0638\u064A\u0641\u0629 \u0645\u0646 \u0648\u0638\u0627\u0626\u0641 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u062E\u062A\u0644\u0641\u0629\u060C \u0648\u064A\u0634\u0631\u062D \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0628\u0634\u0643\u0644 \u0633\u0647\u0644 \u0648\u0645\u0628\u0633\u0637.\u003C/p\u003E\u003Ch2\u003E\u0639\u0646 \u0627\u0644\u0646\u0638\u0627\u0645\u003C/h2\u003E\u003Cp\u003E\u0646\u0638\u0627\u0645 \u0645\u062A\u0643\u0627\u0645\u0644 \u064A\u0633\u0647\u0651\u0644 \u0625\u062F\u0627\u0631\u0629 \u0627\u0644\u0646\u0645\u0627\u0630\u062C \u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A\u0629 \u0648\u062A\u0646\u0638\u064A\u0645 \u0625\u062C\u0631\u0627\u0621\u0627\u062A \u0627\u0644\u0639\u0645\u0644 \u0628\u0633\u0644\u0627\u0633\u0629 \u0648\u062F\u0642\u0629\u060C \u0628\u0645\u0627 \u064A\u0633\u0631\u0639 \u0625\u0646\u062C\u0627\u0632 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062A \u0648\u064A\u0639\u0632\u0632 \u0643\u0641\u0627\u0621\u0629 \u0627\u0644\u0623\u062F\u0627\u0621\u060C \u0648\u0635\u0648\u0644\u064B\u0627 \u0625\u0644\u0649 \u0628\u064A\u0626\u0629 \u0639\u0645\u0644 \u062D\u062F\u064A\u062B\u0629 \u0628\u0644\u0627 \u0648\u0631\u0642.\u003C/p\u003E\u003Ch2\u003E\u0627\u0644\u062E\u0635\u0648\u0635\u064A\u0629 \u0648\u062D\u0642\u0648\u0642 \u0627\u0644\u0645\u0644\u0643\u064A\u0629\u003C/h2\u003E\u003Cp\u003E\u0648\u064A\u0639\u062A\u0628\u0631 \u0646\u0633\u062E \u0647\u0630\u0647 \u0627\u0644\u0648\u062B\u064A\u0642\u0629 \u0623\u0648 \u0623\u064A \u062C\u0632\u0621 \u0645\u0646\u0647\u0627 \u0623\u0648 \u0645\u062D\u062A\u0648\u0649 \u0645\u0631\u0641\u0642 \u0645\u0639\u0647\u0627 \u062F\u0648\u0646 \u062A\u0631\u062E\u064A\u0635 \u0645\u0633\u0628\u0642 \u0645\u0646 \u0645\u0627\u0644\u0643\u064A \u0627\u0644\u0646\u0638\u0627\u0645 \u0623\u0645\u0631\u0627\u064B \u0645\u0645\u0646\u0648\u0639\u0627\u064B \u0648\u064A\u0639\u062A\u0628\u0631 \u062E\u0631\u0642\u0627\u064B \u0644\u0644\u0642\u0627\u0646\u0648\u0646.\u003C/p\u003E\u003Cdiv class=\u0022alert-box\u0022\u003E\u003Cstrong\u003E\uD83D\uDCA1 \u0645\u0644\u0627\u062D\u0638\u0629:\u003C/strong\u003E \u0627\u0636\u063A\u0637 \u0639\u0644\u0649 \u0627\u0644\u0645\u0639\u0627\u064A\u0646\u0629 \u064A\u0633\u0627\u0631\u0627\u064B \u0644\u0639\u0631\u0636 \u062A\u0641\u0627\u0635\u064A\u0644 \u0627\u0644\u0645\u0628\u0627\u062F\u0631\u0629 \u0628\u062D\u062C\u0645 \u0643\u0627\u0645\u0644 \u0648\u0645\u0643\u0628\u0631.\u003C/div\u003E",
